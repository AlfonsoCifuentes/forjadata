{
  "name": "@forjadata/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/functions/*.js",
  "scripts": {
    "dev": "tsx watch src/local-server.ts",
    "start": "node dist/local-server.js",
    "start:functions": "pnpm build && func start",
    "build": "tsc -p tsconfig.json && esbuild src/functions/api-v1.ts src/functions/workers.ts --bundle --platform=node --format=esm --target=node24 --sourcemap --outdir=dist/functions --external:@azure/functions --external:pino --banner:js=\"import { createRequire as __forjadataCreateRequire } from 'node:module'; const require = __forjadataCreateRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run src/api.integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit",
    "lint:fix": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure-rest/ai-document-intelligence": "1.1.0",
    "@azure/communication-email": "1.1.0",
    "@azure/core-auth": "1.10.1",
    "@azure/functions": "4.16.2",
    "@azure/functions-opentelemetry-instrumentation": "0.3.0",
    "@azure/identity": "4.13.1",
    "@azure/monitor-opentelemetry": "1.19.0",
    "@azure/service-bus": "7.9.5",
    "@azure/storage-blob": "12.33.0",
    "@forjadata/ai-prompts": "workspace:*",
    "@forjadata/config": "workspace:*",
    "@forjadata/contracts": "workspace:*",
    "@forjadata/domain": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "jose": "6.2.4",
    "openai": "7.2.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
