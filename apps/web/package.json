{
  "name": "@forjadata/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p typecheck \"build-only {@}\" --",
    "preview": "vite preview",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual-regression.spec.ts",
    "test:a11y": "playwright test --grep @a11y",
    "build-only": "vite build",
    "typecheck": "vue-tsc --build",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@azure/msal-browser": "5.17.3",
    "@forjadata/contracts": "workspace:*",
    "@forjadata/domain": "workspace:*",
    "@lucide/vue": "1.28.0",
    "ag-grid-community": "36.0.2",
    "ag-grid-vue3": "36.0.2",
    "date-fns": "4.4.0",
    "echarts": "6.1.0",
    "pinia": "^4.0.2",
    "three": "0.185.1",
    "vee-validate": "4.15.1",
    "vue": "^3.5.40",
    "vue-i18n": "11.4.8",
    "vue-router": "^5.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/vue": "8.1.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.76.0",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "msw": "2.15.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.76.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
