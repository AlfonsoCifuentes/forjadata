# Web
VITE_APP_NAME=Forjadata
VITE_APP_ENV=local
VITE_API_MODE=auto
VITE_API_BASE_URL=http://localhost:7071/api/v1
VITE_AUTH_MODE=demo
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_ENTRA_API_SCOPE=
VITE_DEMO_ENABLED=true
VITE_DEFAULT_LOCALE=es
VITE_ENABLE_3D=false
VITE_ENABLE_ARCHITECTURE_PAGE=true
VITE_TELEMETRY_ENABLED=false

# API
NODE_ENV=development
APP_ENV=local
PUBLIC_APP_URL=http://localhost:5173
PORT=7071
DATABASE_MODE=memory
DATABASE_URL=postgresql://forjadata:forjadata@localhost:5432/forjadata
AUTH_MODE=demo
DEMO_ENABLED=true
ENFORCE_REAL_INTEGRATIONS=false
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_ALLOWED_AUDIENCES=
ENTRA_REQUIRED_SCOPE=access_as_user
ENTRA_JWKS_URI=
ENTRA_ISSUER=
STORAGE_MODE=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
BLOB_DOCUMENTS_CONTAINER=documents
BLOB_EXTRACTIONS_CONTAINER=extractions
BLOB_SAP_PAYLOADS_CONTAINER=sap-payloads
BLOB_UAT_EVIDENCE_CONTAINER=uat-evidence
MAX_DOCUMENT_BYTES=10000000
QUEUE_MODE=inline
AZURE_SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=
SERVICE_BUS_DOCUMENT_QUEUE=document-processing
SERVICE_BUS_SAP_QUEUE=sap-sync
AI_MODE=mock
DOCUMENT_MODE=mock
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AI_MAX_INPUT_CHARS=30000
AI_MAX_OUTPUT_TOKENS=1500
SAP_MODE=simulator
SAP_BASE_URL=http://localhost:7072
SAP_CLIENT=
SAP_USERNAME=
SAP_PASSWORD=
SAP_API_KEY=
SAP_API_KEY_HEADER=APIKey
SAP_ODATA_V2_PRODUCT_PATH=/sap/opu/odata/SAP/API_PRODUCT_SRV/A_Product
SAP_ODATA_V4_PRODUCT_PATH=/sap/opu/odata4/sap/api_product/srvd_a2x/sap/product/0002/Product
SAP_PRODUCT_TYPE=ROH
SAP_INDUSTRY_SECTOR=M
SAP_LANGUAGE=EN
SAP_TIMEOUT_MS=10000

# Email: log is an explicit local simulator. Use Azure Communication Services only with
# a configured endpoint, verified sender and intentional recipient.
EMAIL_MODE=log
AZURE_COMMUNICATION_EMAIL_ENDPOINT=
AZURE_COMMUNICATION_EMAIL_SENDER=
NOTIFICATION_EMAIL_RECIPIENT=
EMAIL_TIMEOUT_MS=15000
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPLICATIONINSIGHTS_SAMPLING_RATIO=0.1
APPLICATIONINSIGHTS_TRACES_PER_SECOND=2
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
DEMO_RESET_SECRET=local-demo-only
