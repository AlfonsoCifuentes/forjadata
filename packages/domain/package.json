    "test:coverage": "vitest run src --coverage",
    "lint": "tsc -p tsconfig.json --noEmit",
    "lint:fix": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@forjadata/contracts": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
