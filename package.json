{
  "name": "forjadata",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma inteligente para catalogar, validar y sincronizar materiales empresariales.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @forjadata/api --filter @forjadata/sap-simulator --filter @forjadata/web dev",
    "dev:web": "pnpm --filter @forjadata/web dev",
    "dev:api": "pnpm --filter @forjadata/api dev",
    "dev:sap": "pnpm --filter @forjadata/sap-simulator dev",
    "postinstall": "prisma generate",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test:run",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm --filter @forjadata/api test:integration",
    "test:e2e": "pnpm --filter @forjadata/web test:e2e",
    "test:visual": "pnpm --filter @forjadata/web test:visual",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:a11y": "pnpm --filter @forjadata/web test:a11y",
    "test:performance": "pnpm --filter @forjadata/web build-only && tsx scripts/lighthouse-ci.ts",
    "test:functions": "pnpm --filter @forjadata/api build && tsx scripts/smoke-functions.ts",
    "package:functions": "pnpm --filter @forjadata/api build && tsx scripts/package-functions.ts",
    "package:web": "pnpm --filter @forjadata/web build && tsx scripts/package-web.ts",
    "entra:redirects": "tsx scripts/update-entra-redirects.ts",
    "db:up": "docker compose up -d postgres azurite",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:validate": "prisma validate",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:validate": "tsx scripts/generate-openapi.ts --check",
    "infra:validate": "tsx scripts/validate-infra.ts",
    "security:check": "tsx scripts/check-repository-safety.ts && pnpm audit --prod --audit-level=high",
    "verify": "pnpm format:check && pnpm openapi:validate && pnpm infra:validate && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:functions"
  },
  "devDependencies": {
    "@faker-js/faker": "10.5.0",
    "@forjadata/domain": "workspace:*",
    "@lhci/cli": "0.15.1",
    "@prisma/adapter-pg": "7.9.1",
    "@types/pg": "8.20.0",
    "chrome-launcher": "1.2.1",
    "dotenv": "17.4.2",
    "lighthouse": "12.6.1",
    "pg": "8.22.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
